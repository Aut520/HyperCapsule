<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 主背景深邃渐变（HyperOS 经典灵动深蓝到深紫晶） -->
    <path
        android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF1E40AF"
                android:centerColor="#FF1E1B4B"
                android:endColor="#FF0F172A" />
        </aapt:attr>
    </path>
    <!-- 顶部中央高光柔光弧（增加立体感与光泽度） -->
    <path
        android:pathData="M14,14 C38,0 70,0 94,14 C104,20 94,44 76,36 C58,28 38,32 26,40 C16,46 4,20 14,14 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="20"
                android:gradientRadius="48"
                android:startColor="#4060A5FA"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>
</vector>
